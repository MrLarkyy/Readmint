{
  "name": "readmint",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "editor": "pnpm --filter @readmint/editor dev",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "examples": "pnpm --filter @readmint/examples... build && node packages/examples/dist/bin.js packages/components/templates",
    "wiki": "tsc -b packages/wiki/tsconfig.build.json && node packages/wiki/dist/bin.js docs .wiki-out",
    "golden:update": "vitest run --mode golden-update --project node",
    "schema:update": "vitest run --mode schema-update --project node packages/format/test/schemaFile.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.4",
    "eslint": "10.12.0",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
