{
  "name": "@readmint/raster",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@readmint/fonts": "workspace:*",
    "@readmint/format": "workspace:*",
    "@readmint/renderer": "workspace:*",
    "@resvg/resvg-wasm": "2.6.2",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "wasm-webp": "0.1.0"
  },
  "devDependencies": {
    "@readmint/golden": "workspace:*",
    "@types/omggif": "1.0.5",
    "@types/pngjs": "6.0.5",
    "omggif": "1.0.10",
    "pngjs": "7.0.0"
  }
}
