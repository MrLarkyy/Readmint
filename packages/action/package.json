{
  "name": "@readmint/action",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "bundle": "rolldown -c rolldown.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@readmint/cli": "workspace:*",
    "@readmint/data-github": "workspace:*",
    "@readmint/raster": "workspace:*"
  },
  "devDependencies": {
    "rolldown": "1.2.13",
    "yaml": "2.9.1"
  }
}
