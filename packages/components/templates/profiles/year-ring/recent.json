{
  "$schema": "https://raw.githubusercontent.com/MrLarkyy/Readmint/main/packages/format/schema/design-v0.schema.json",
  "version": 0,
  "title": "Recent work",
  "description": "The latest pushes: commit, repository, message and the lines added and removed.",
  "canvas": {
    "width": 840,
    "height": 356
  },
  "assets": {
    "fonts": {
      "reg": {
        "family": "Archivo",
        "src": "fonts/Archivo-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "semi": {
        "family": "Archivo",
        "src": "fonts/Archivo-SemiBold.ttf",
        "weight": 600,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "bold": {
        "family": "Archivo",
        "src": "fonts/Archivo-Bold.ttf",
        "weight": 700,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      }
    }
  },
  "animation": {
    "duration": 60000,
    "loop": false
  },
  "components": {
    "card": {
      "description": "The section: a rounded panel in the theme's colours; the theme prop is the only switch between light and dark.",
      "props": {
        "theme": {
          "type": "enum",
          "values": ["light", "dark"],
          "default": "light"
        }
      },
      "layers": [
        {
          "type": "rect",
          "x": 0.5,
          "y": 0.5,
          "width": 839,
          "height": 355,
          "radius": 14,
          "fill": "{{ props.theme == \"dark\" ? \"#0b1020\" : \"#f6f8fd\" }}",
          "stroke": "{{ props.theme == \"dark\" ? \"#1f2a4a\" : \"#d6dcec\" }}",
          "strokeWidth": 1
        },
        {
          "type": "text",
          "x": 40,
          "y": 32,
          "content": "RECENT WORK",
          "font": "semi",
          "fontSize": 12,
          "letterSpacing": 2,
          "fill": "{{ props.theme == \"dark\" ? \"#6b8cff\" : \"#1f4fe0\" }}"
        },
        {
          "type": "group",
          "children": [
            {
              "type": "text",
              "x": 0,
              "y": 6,
              "content": "{{ github.pushes[k].hash | truncate(7) }}",
              "font": "reg",
              "fontSize": 13,
              "fill": "{{ props.theme == \"dark\" ? \"#8d9aca\" : \"#5d6788\" }}"
            },
            {
              "type": "group",
              "x": 84,
              "y": 0,
              "width": 200,
              "height": 24,
              "clip": true,
              "children": [
                {
                  "type": "text",
                  "x": 0,
                  "y": 4,
                  "content": "{{ github.pushes[k].repository | truncate(22) }}",
                  "font": "semi",
                  "fontSize": 15,
                  "fill": "{{ props.theme == \"dark\" ? \"#e9eeff\" : \"#0b1230\" }}"
                }
              ]
            },
            {
              "type": "group",
              "x": 290,
              "y": 0,
              "width": 350,
              "height": 24,
              "clip": true,
              "children": [
                {
                  "type": "text",
                  "x": 0,
                  "y": 4,
                  "content": "{{ github.pushes[k].message | truncate(48) }}",
                  "font": "reg",
                  "fontSize": 15,
                  "fill": "{{ props.theme == \"dark\" ? \"#8d9aca\" : \"#5d6788\" }}"
                }
              ]
            },
            {
              "type": "rect",
              "x": 650,
              "y": 5,
              "width": "{{ (((github.pushes[k].additions | min(64)) <= 1 ? (github.pushes[k].additions | min(64)) : ((github.pushes[k].additions | min(64)) <= 4 ? 1 + ((github.pushes[k].additions | min(64)) - 1) / 3 : ((github.pushes[k].additions | min(64)) <= 16 ? 2 + ((github.pushes[k].additions | min(64)) - 4) / 6 : 4 + ((github.pushes[k].additions | min(64)) - 16) / 12))) * 8.5) | max(1) }}",
              "height": 6,
              "fill": "{{ props.theme == \"dark\" ? \"#3ddc97\" : \"#1f9d63\" }}"
            },
            {
              "type": "rect",
              "x": 650,
              "y": 17,
              "width": "{{ (((github.pushes[k].deletions | min(64)) <= 1 ? (github.pushes[k].deletions | min(64)) : ((github.pushes[k].deletions | min(64)) <= 4 ? 1 + ((github.pushes[k].deletions | min(64)) - 1) / 3 : ((github.pushes[k].deletions | min(64)) <= 16 ? 2 + ((github.pushes[k].deletions | min(64)) - 4) / 6 : 4 + ((github.pushes[k].deletions | min(64)) - 16) / 12))) * 8.5) | max(1) }}",
              "height": 6,
              "fill": "{{ props.theme == \"dark\" ? \"#ff6b7a\" : \"#d64550\" }}"
            },
            {
              "type": "group",
              "x": 730,
              "y": 0,
              "width": 70,
              "height": 12,
              "clip": true,
              "children": [
                {
                  "type": "text",
                  "x": 0,
                  "y": 0,
                  "content": "{{ \"+\" + (github.pushes[k].additions | compact) }}",
                  "font": "reg",
                  "fontSize": 11,
                  "fill": "{{ props.theme == \"dark\" ? \"#3ddc97\" : \"#1f9d63\" }}"
                }
              ]
            },
            {
              "type": "group",
              "x": 730,
              "y": 14,
              "width": 70,
              "height": 12,
              "clip": true,
              "children": [
                {
                  "type": "text",
                  "x": 0,
                  "y": 0,
                  "content": "{{ \"-\" + (github.pushes[k].deletions | compact) }}",
                  "font": "reg",
                  "fontSize": 11,
                  "fill": "{{ props.theme == \"dark\" ? \"#ff6b7a\" : \"#d64550\" }}"
                }
              ]
            },
            {
              "type": "rect",
              "x": 0,
              "y": 38,
              "width": 760,
              "height": 1,
              "fill": "{{ props.theme == \"dark\" ? \"#19213d\" : \"#e3e8f5\" }}"
            }
          ],
          "x": 40,
          "y": "{{ 62 + k * 46 }}",
          "repeat": {
            "each": "{{ [0, 1, 2, 3, 4, 5] }}",
            "as": "k"
          },
          "if": "{{ github.pushes[k] }}"
        },
        {
          "type": "group",
          "x": 1,
          "y": 56,
          "width": 838,
          "height": 276,
          "clip": true,
          "children": [
            {
              "type": "rect",
              "x": 0,
              "y": 276,
              "width": 838,
              "height": 276,
              "fill": "{{ props.theme == \"dark\" ? \"#0b1020\" : \"#f6f8fd\" }}",
              "animate": {
                "y": {
                  "keyframes": [
                    {
                      "offset": 0,
                      "value": 0
                    },
                    {
                      "offset": 0,
                      "value": -276
                    },
                    {
                      "offset": 0.185,
                      "value": -276
                    },
                    {
                      "offset": 0.321,
                      "value": -276
                    },
                    {
                      "offset": 0.321,
                      "value": -230
                    },
                    {
                      "offset": 0.457,
                      "value": -230
                    },
                    {
                      "offset": 0.457,
                      "value": -184
                    },
                    {
                      "offset": 0.593,
                      "value": -184
                    },
                    {
                      "offset": 0.593,
                      "value": -138
                    },
                    {
                      "offset": 0.728,
                      "value": -138
                    },
                    {
                      "offset": 0.728,
                      "value": -92
                    },
                    {
                      "offset": 0.864,
                      "value": -92
                    },
                    {
                      "offset": 0.864,
                      "value": -46
                    },
                    {
                      "offset": 1,
                      "value": 0
                    }
                  ],
                  "duration": 1620
                }
              }
            }
          ]
        },
        {
          "type": "text",
          "x": 40,
          "y": 70,
          "content": "No recent pushes yet.",
          "font": "reg",
          "fontSize": 15,
          "fill": "{{ props.theme == \"dark\" ? \"#8d9aca\" : \"#5d6788\" }}",
          "if": "{{ !github.pushes[0] }}"
        }
      ]
    }
  },
  "layers": [
    {
      "type": "component",
      "ref": "card",
      "props": {
        "theme": "light"
      }
    }
  ]
}
