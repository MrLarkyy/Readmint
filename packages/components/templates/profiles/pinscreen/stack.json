{
  "$schema": "https://raw.githubusercontent.com/MrLarkyy/Readmint/main/packages/format/schema/design-v0.schema.json",
  "version": 0,
  "title": "Stack",
  "description": "The most used languages as a build script: one dependency line per language with a bar for its share.",
  "canvas": {
    "width": 840,
    "height": 300
  },
  "assets": {
    "fonts": {
      "sans": {
        "family": "Geist",
        "src": "fonts/Geist-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "sansB": {
        "family": "Geist",
        "src": "fonts/Geist-SemiBold.ttf",
        "weight": 600,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "mono": {
        "family": "Geist Mono",
        "src": "fonts/GeistMono-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "monoM": {
        "family": "Geist Mono",
        "src": "fonts/GeistMono-Medium.ttf",
        "weight": 500,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      }
    }
  },
  "animation": {
    "duration": 60000,
    "loop": false
  },
  "components": {
    "card": {
      "description": "The section: a rounded panel in the theme's colours; the theme prop is the only switch between light and dark.",
      "props": {
        "theme": {
          "type": "enum",
          "values": ["light", "dark"],
          "default": "light"
        }
      },
      "layers": [
        {
          "type": "rect",
          "x": 0.5,
          "y": 0.5,
          "width": 839,
          "height": 299,
          "radius": 8,
          "fill": "{{ props.theme == \"dark\" ? \"#2b2b2b\" : \"#ffffff\" }}",
          "stroke": "{{ props.theme == \"dark\" ? \"#323232\" : \"#ebecf0\" }}",
          "strokeWidth": 1
        },
        {
          "type": "rect",
          "x": 1,
          "y": 1,
          "width": 838,
          "height": 33,
          "radius": 7,
          "fill": "{{ props.theme == \"dark\" ? \"#3c3f41\" : \"#f7f8fa\" }}"
        },
        {
          "type": "rect",
          "x": 1,
          "y": 18,
          "width": 838,
          "height": 16,
          "fill": "{{ props.theme == \"dark\" ? \"#3c3f41\" : \"#f7f8fa\" }}"
        },
        {
          "type": "rect",
          "x": 1,
          "y": 34,
          "width": 838,
          "height": 1,
          "fill": "{{ props.theme == \"dark\" ? \"#323232\" : \"#ebecf0\" }}"
        },
        {
          "type": "rect",
          "x": 1,
          "y": 35,
          "width": 48,
          "height": 264,
          "fill": "{{ props.theme == \"dark\" ? \"#313335\" : \"#f7f8fa\" }}"
        },
        {
          "type": "text",
          "x": 16,
          "y": 11,
          "content": "{{ (github.login | truncate(30)) + \"  /  build.gradle.kts\" }}",
          "font": "sans",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#808080\" : \"#6c707e\" }}"
        },
        {
          "type": "text",
          "x": 6,
          "y": 48,
          "content": "1",
          "font": "mono",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#606366\" : \"#aeb3c2\" }}",
          "width": 34,
          "align": "end"
        },
        {
          "type": "text",
          "x": 6,
          "y": 72,
          "content": "2",
          "font": "mono",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#606366\" : \"#aeb3c2\" }}",
          "width": 34,
          "align": "end"
        },
        {
          "type": "text",
          "x": 6,
          "y": 96,
          "content": "3",
          "font": "mono",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#606366\" : \"#aeb3c2\" }}",
          "width": 34,
          "align": "end"
        },
        {
          "type": "text",
          "x": 6,
          "y": 120,
          "content": "4",
          "font": "mono",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#606366\" : \"#aeb3c2\" }}",
          "width": 34,
          "align": "end"
        },
        {
          "type": "text",
          "x": 6,
          "y": 144,
          "content": "5",
          "font": "mono",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#606366\" : \"#aeb3c2\" }}",
          "width": 34,
          "align": "end"
        },
        {
          "type": "text",
          "x": 6,
          "y": 168,
          "content": "6",
          "font": "mono",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#606366\" : \"#aeb3c2\" }}",
          "width": 34,
          "align": "end"
        },
        {
          "type": "text",
          "x": 6,
          "y": 192,
          "content": "7",
          "font": "mono",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#606366\" : \"#aeb3c2\" }}",
          "width": 34,
          "align": "end"
        },
        {
          "type": "text",
          "x": 6,
          "y": 216,
          "content": "8",
          "font": "mono",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#606366\" : \"#aeb3c2\" }}",
          "width": 34,
          "align": "end"
        },
        {
          "type": "text",
          "x": 6,
          "y": 240,
          "content": "9",
          "font": "mono",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#606366\" : \"#aeb3c2\" }}",
          "width": 34,
          "align": "end"
        },
        {
          "type": "text",
          "x": 6,
          "y": 264,
          "content": "10",
          "font": "mono",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#606366\" : \"#aeb3c2\" }}",
          "width": 34,
          "align": "end"
        },
        {
          "type": "text",
          "x": 64,
          "y": 44,
          "content": "// languages by bytes",
          "font": "mono",
          "fontSize": 14,
          "fill": "{{ props.theme == \"dark\" ? \"#808080\" : \"#8c8c8c\" }}"
        },
        {
          "type": "text",
          "x": 64,
          "y": 68,
          "content": "dependencies",
          "font": "mono",
          "fontSize": 14,
          "fill": "{{ props.theme == \"dark\" ? \"#ffc66d\" : \"#00627a\" }}"
        },
        {
          "type": "text",
          "x": 173.2,
          "y": 68,
          "content": "{",
          "font": "mono",
          "fontSize": 14,
          "fill": "{{ props.theme == \"dark\" ? \"#a9b7c6\" : \"#080808\" }}"
        },
        {
          "type": "group",
          "children": [
            {
              "type": "text",
              "x": 0,
              "y": 0,
              "content": "implementation",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#ffc66d\" : \"#00627a\" }}"
            },
            {
              "type": "text",
              "x": 117.60000000000001,
              "y": 0,
              "content": "(",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#a9b7c6\" : \"#080808\" }}"
            },
            {
              "type": "text",
              "x": 126,
              "y": 0,
              "content": "{{ \"\\\"\" + (github.languages[k].name | truncate(24)) + \"\\\"\" }}",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#6a8759\" : \"#067d17\" }}"
            },
            {
              "type": "text",
              "x": "{{ (17 + ((github.languages[k].name | truncate(24)) | length)) * 8.4 }}",
              "y": 0,
              "content": ")",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#a9b7c6\" : \"#080808\" }}"
            }
          ],
          "x": 97.6,
          "y": "{{ 92 + k * 24 }}",
          "repeat": {
            "each": "{{ [0, 1, 2, 3, 4, 5, 6] }}",
            "as": "k"
          },
          "if": "{{ github.languages[k] }}"
        },
        {
          "type": "group",
          "x": 560,
          "y": 92,
          "width": 240,
          "height": 170,
          "clip": true,
          "children": [
            {
              "type": "group",
              "children": [
                {
                  "type": "rect",
                  "x": 0,
                  "y": 4,
                  "width": 170,
                  "height": 8,
                  "radius": 4,
                  "fill": "{{ props.theme == \"dark\" ? \"#323232\" : \"#ebecf0\" }}"
                },
                {
                  "type": "rect",
                  "x": 0,
                  "y": 4,
                  "width": "{{ (170 * github.languages[k].share / ((github.languages[0].share) | max(0.01))) | max(4) }}",
                  "height": 8,
                  "radius": 4,
                  "fill": "{{ props.theme == \"dark\" ? \"#4a88c7\" : \"#3574f0\" }}"
                },
                {
                  "type": "text",
                  "x": 180,
                  "y": 0,
                  "content": "{{ github.languages[k].share | percent(0) }}",
                  "font": "mono",
                  "fontSize": 12,
                  "fill": "{{ props.theme == \"dark\" ? \"#808080\" : \"#6c707e\" }}"
                }
              ],
              "y": "{{ k * 24 }}",
              "repeat": {
                "each": "{{ [0, 1, 2, 3, 4, 5, 6] }}",
                "as": "k"
              },
              "if": "{{ github.languages[k] }}"
            },
            {
              "type": "rect",
              "x": 240,
              "y": 0,
              "width": 240,
              "height": 170,
              "fill": "{{ props.theme == \"dark\" ? \"#2b2b2b\" : \"#ffffff\" }}",
              "animate": {
                "x": {
                  "keyframes": [
                    {
                      "offset": 0,
                      "value": 0
                    },
                    {
                      "offset": 0,
                      "value": -240
                    },
                    {
                      "offset": 0.158,
                      "value": -240
                    },
                    {
                      "offset": 1,
                      "value": 0
                    }
                  ],
                  "duration": 1900,
                  "easing": "linear"
                }
              }
            }
          ]
        },
        {
          "type": "text",
          "x": 64,
          "y": 260,
          "content": "}",
          "font": "mono",
          "fontSize": 14,
          "fill": "{{ props.theme == \"dark\" ? \"#a9b7c6\" : \"#080808\" }}"
        },
        {
          "type": "text",
          "x": 97.6,
          "y": 92,
          "content": "// no language data yet",
          "font": "mono",
          "fontSize": 14,
          "fill": "{{ props.theme == \"dark\" ? \"#808080\" : \"#8c8c8c\" }}",
          "if": "{{ !(github.languages | length) }}"
        }
      ]
    }
  },
  "layers": [
    {
      "type": "component",
      "ref": "card",
      "props": {
        "theme": "light"
      }
    }
  ]
}
