{
  "$schema": "https://raw.githubusercontent.com/MrLarkyy/Readmint/main/packages/format/schema/design-v0.schema.json",
  "version": 0,
  "title": "Repository",
  "description": "A repository written as a Kotlin object: its name, stars, forks, language and description.",
  "canvas": {
    "width": 840,
    "height": 236
  },
  "assets": {
    "fonts": {
      "sans": {
        "family": "Geist",
        "src": "fonts/Geist-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "sansB": {
        "family": "Geist",
        "src": "fonts/Geist-SemiBold.ttf",
        "weight": 600,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "mono": {
        "family": "Geist Mono",
        "src": "fonts/GeistMono-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "monoM": {
        "family": "Geist Mono",
        "src": "fonts/GeistMono-Medium.ttf",
        "weight": 500,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      }
    }
  },
  "components": {
    "card": {
      "description": "The section: a rounded panel in the theme's colours; the theme prop is the only switch between light and dark.",
      "props": {
        "theme": {
          "type": "enum",
          "values": ["light", "dark"],
          "default": "light"
        },
        "slot": {
          "type": "number",
          "default": 0
        }
      },
      "layers": [
        {
          "type": "rect",
          "x": 0.5,
          "y": 0.5,
          "width": 839,
          "height": 235,
          "radius": 8,
          "fill": "{{ props.theme == \"dark\" ? \"#2b2b2b\" : \"#ffffff\" }}",
          "stroke": "{{ props.theme == \"dark\" ? \"#323232\" : \"#ebecf0\" }}",
          "strokeWidth": 1
        },
        {
          "type": "rect",
          "x": 1,
          "y": 1,
          "width": 838,
          "height": 33,
          "radius": 7,
          "fill": "{{ props.theme == \"dark\" ? \"#3c3f41\" : \"#f7f8fa\" }}"
        },
        {
          "type": "rect",
          "x": 1,
          "y": 18,
          "width": 838,
          "height": 16,
          "fill": "{{ props.theme == \"dark\" ? \"#3c3f41\" : \"#f7f8fa\" }}"
        },
        {
          "type": "rect",
          "x": 1,
          "y": 34,
          "width": 838,
          "height": 1,
          "fill": "{{ props.theme == \"dark\" ? \"#323232\" : \"#ebecf0\" }}"
        },
        {
          "type": "rect",
          "x": 1,
          "y": 35,
          "width": 48,
          "height": 200,
          "fill": "{{ props.theme == \"dark\" ? \"#313335\" : \"#f7f8fa\" }}"
        },
        {
          "type": "text",
          "x": 16,
          "y": 11,
          "content": "{{ (github.login | truncate(24)) + \"  /  \" + (((github.pinned || github.repositories)[props.slot]).name | default(\"repository\") | truncate(26)) + \".kt\" }}",
          "font": "sans",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#808080\" : \"#6c707e\" }}"
        },
        {
          "type": "text",
          "x": 6,
          "y": 48,
          "content": "1",
          "font": "mono",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#606366\" : \"#aeb3c2\" }}",
          "width": 34,
          "align": "end"
        },
        {
          "type": "text",
          "x": 6,
          "y": 72,
          "content": "2",
          "font": "mono",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#606366\" : \"#aeb3c2\" }}",
          "width": 34,
          "align": "end"
        },
        {
          "type": "text",
          "x": 6,
          "y": 96,
          "content": "3",
          "font": "mono",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#606366\" : \"#aeb3c2\" }}",
          "width": 34,
          "align": "end"
        },
        {
          "type": "text",
          "x": 6,
          "y": 120,
          "content": "4",
          "font": "mono",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#606366\" : \"#aeb3c2\" }}",
          "width": 34,
          "align": "end"
        },
        {
          "type": "text",
          "x": 6,
          "y": 144,
          "content": "5",
          "font": "mono",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#606366\" : \"#aeb3c2\" }}",
          "width": 34,
          "align": "end"
        },
        {
          "type": "text",
          "x": 6,
          "y": 168,
          "content": "6",
          "font": "mono",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#606366\" : \"#aeb3c2\" }}",
          "width": 34,
          "align": "end"
        },
        {
          "type": "text",
          "x": 6,
          "y": 192,
          "content": "7",
          "font": "mono",
          "fontSize": 12,
          "fill": "{{ props.theme == \"dark\" ? \"#606366\" : \"#aeb3c2\" }}",
          "width": 34,
          "align": "end"
        },
        {
          "type": "group",
          "children": [
            {
              "type": "text",
              "x": 64,
              "y": 44,
              "content": "{{ \"// repository \" + [\"1\", \"2\", \"3\", \"4\"][props.slot] }}",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#808080\" : \"#8c8c8c\" }}"
            },
            {
              "type": "text",
              "x": 64,
              "y": 68,
              "content": "object",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#cc7832\" : \"#0033b3\" }}"
            },
            {
              "type": "text",
              "x": 122.8,
              "y": 68,
              "content": "{{ (r.name | truncate(26)) }}",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#ffc66d\" : \"#00627a\" }}"
            },
            {
              "type": "text",
              "x": "{{ 64 + (8 + ((r.name | truncate(26)) | length)) * 8.4 }}",
              "y": 68,
              "content": "{",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#a9b7c6\" : \"#080808\" }}"
            },
            {
              "type": "text",
              "x": 97.6,
              "y": 92,
              "content": "val",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#cc7832\" : \"#0033b3\" }}"
            },
            {
              "type": "text",
              "x": 131.2,
              "y": 92,
              "content": "stars",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#9876aa\" : \"#871094\" }}"
            },
            {
              "type": "text",
              "x": 181.6,
              "y": 92,
              "content": "=",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#a9b7c6\" : \"#080808\" }}"
            },
            {
              "type": "text",
              "x": 198.4,
              "y": 92,
              "content": "{{ r.stars }}",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#6897bb\" : \"#1750eb\" }}"
            },
            {
              "type": "text",
              "x": 97.6,
              "y": 116,
              "content": "val",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#cc7832\" : \"#0033b3\" }}"
            },
            {
              "type": "text",
              "x": 131.2,
              "y": 116,
              "content": "forks",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#9876aa\" : \"#871094\" }}"
            },
            {
              "type": "text",
              "x": 181.6,
              "y": 116,
              "content": "=",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#a9b7c6\" : \"#080808\" }}"
            },
            {
              "type": "text",
              "x": 198.4,
              "y": 116,
              "content": "{{ r.forks }}",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#6897bb\" : \"#1750eb\" }}"
            },
            {
              "type": "text",
              "x": 97.6,
              "y": 140,
              "content": "val",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#cc7832\" : \"#0033b3\" }}"
            },
            {
              "type": "text",
              "x": 131.2,
              "y": 140,
              "content": "language",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#9876aa\" : \"#871094\" }}"
            },
            {
              "type": "text",
              "x": 206.8,
              "y": 140,
              "content": "=",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#a9b7c6\" : \"#080808\" }}"
            },
            {
              "type": "text",
              "x": 223.6,
              "y": 140,
              "content": "{{ \"\\\"\" + (r.primaryLanguage.name | default(\"Text\") | truncate(24)) + \"\\\"\" }}",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#6a8759\" : \"#067d17\" }}"
            },
            {
              "type": "text",
              "x": 97.6,
              "y": 164,
              "content": "val",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#cc7832\" : \"#0033b3\" }}"
            },
            {
              "type": "text",
              "x": 131.2,
              "y": 164,
              "content": "description",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#9876aa\" : \"#871094\" }}"
            },
            {
              "type": "text",
              "x": 232,
              "y": 164,
              "content": "=",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#a9b7c6\" : \"#080808\" }}"
            },
            {
              "type": "text",
              "x": 248.8,
              "y": 164,
              "content": "{{ \"\\\"\" + (r.description | default(\"\") | truncate(52)) + \"\\\"\" }}",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#6a8759\" : \"#067d17\" }}"
            },
            {
              "type": "text",
              "x": 64,
              "y": 188,
              "content": "}",
              "font": "mono",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#a9b7c6\" : \"#080808\" }}"
            }
          ],
          "repeat": {
            "each": "{{ [((github.pinned || github.repositories)[props.slot])] }}",
            "as": "r"
          },
          "if": "{{ r }}"
        },
        {
          "type": "text",
          "x": 64,
          "y": 44,
          "content": "// no repository in this slot yet",
          "font": "mono",
          "fontSize": 14,
          "fill": "{{ props.theme == \"dark\" ? \"#808080\" : \"#8c8c8c\" }}",
          "if": "{{ !((github.pinned || github.repositories)[props.slot]) }}"
        }
      ]
    }
  },
  "layers": [
    {
      "type": "component",
      "ref": "card",
      "props": {
        "theme": "dark",
        "slot": 3
      }
    }
  ]
}
