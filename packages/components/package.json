{
  "name": "@readmint/components",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./templates/*": "./templates/*"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@readmint/data-github": "workspace:*",
    "@readmint/examples": "workspace:*",
    "@readmint/format": "workspace:*",
    "@readmint/golden": "workspace:*",
    "@readmint/renderer": "workspace:*"
  }
}
