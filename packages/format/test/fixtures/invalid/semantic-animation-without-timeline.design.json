{
  "version": 0,
  "canvas": {
    "width": 10,
    "height": 10
  },
  "layers": [
    {
      "type": "rect",
      "width": 1,
      "height": 1,
      "animate": {
        "opacity": {
          "keyframes": [
            {
              "offset": 0,
              "value": 0
            },
            {
              "offset": 1,
              "value": 1
            }
          ]
        }
      }
    },
    {
      "type": "rect",
      "width": 1,
      "height": 1,
      "animate": {
        "x": {
          "keyframes": [
            {
              "offset": 0,
              "value": 0
            },
            {
              "offset": 1,
              "value": 1
            }
          ]
        }
      }
    }
  ]
}
