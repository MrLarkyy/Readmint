{
  "version": 0,
  "canvas": {
    "width": 10,
    "height": 10
  },
  "animation": {
    "duration": 1000
  },
  "layers": [
    {
      "type": "rect",
      "width": 1,
      "height": 1,
      "animate": {
        "x": {
          "keyframes": [
            {
              "offset": 0,
              "value": 0
            },
            {
              "offset": 1,
              "value": 1
            }
          ],
          "easing": {
            "x1": 1.5,
            "y1": 0,
            "x2": 1,
            "y2": 1
          }
        }
      }
    }
  ]
}
