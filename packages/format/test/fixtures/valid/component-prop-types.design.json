{
  "version": 0,
  "canvas": { "width": 100, "height": 100 },
  "components": {
    "list": {
      "props": {
        "mode": { "type": "enum", "values": ["a", "b"], "default": "a" },
        "items": { "type": "array", "default": [] },
        "tags": { "type": "array", "default": [1, "x", true] }
      },
      "layers": [
        {
          "type": "rect",
          "width": 4,
          "height": 4,
          "repeat": { "each": "{{ props.items }}", "as": "item" }
        }
      ]
    }
  },
  "layers": [
    { "type": "component", "ref": "list", "props": { "mode": "b", "tags": ["a", 2, false] } },
    { "type": "component", "ref": "list", "props": { "mode": "{{ mode }}", "items": "{{ days }}" } }
  ]
}
