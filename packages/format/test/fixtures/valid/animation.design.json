{
  "version": 0,
  "canvas": {
    "width": 120,
    "height": 40
  },
  "animation": {
    "duration": 1200,
    "loop": true
  },
  "layers": [
    {
      "type": "group",
      "layout": {
        "type": "stack",
        "direction": "row",
        "gap": 2
      },
      "children": [
        {
          "type": "rect",
          "width": 10,
          "height": 10,
          "repeat": {
            "each": "{{cells}}"
          },
          "animate": {
            "opacity": {
              "keyframes": [
                {
                  "offset": 0,
                  "value": 0,
                  "easing": "ease-out"
                },
                {
                  "offset": 0.5,
                  "value": 1
                },
                {
                  "offset": 1,
                  "value": 1
                }
              ],
              "duration": 400,
              "stagger": 40,
              "cycles": 3
            },
            "scale": {
              "keyframes": [
                {
                  "offset": 0,
                  "value": 0.5
                },
                {
                  "offset": 1,
                  "value": 1
                }
              ],
              "duration": 400,
              "delay": "{{index * 40}}",
              "easing": {
                "x1": 0.3,
                "y1": 1.6,
                "x2": 0.6,
                "y2": 1
              }
            },
            "fill": {
              "keyframes": [
                {
                  "offset": 0,
                  "value": "#ebedf0"
                },
                {
                  "offset": 1,
                  "value": "{{item}}"
                }
              ],
              "duration": 400,
              "stagger": 40
            }
          }
        }
      ]
    },
    {
      "type": "path",
      "d": "M0 30 L 60 30 Q 90 10 120 30",
      "stroke": "#0969da",
      "fill": "none",
      "animate": {
        "draw": {
          "keyframes": [
            {
              "offset": 0,
              "value": 0
            },
            {
              "offset": 1,
              "value": 1
            }
          ]
        },
        "stroke": {
          "keyframes": [
            {
              "offset": 0,
              "value": "#0969da"
            },
            {
              "offset": 1,
              "value": "#8250df"
            }
          ]
        }
      }
    }
  ]
}
