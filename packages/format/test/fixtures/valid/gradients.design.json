{
  "version": 0,
  "canvas": {
    "width": 200,
    "height": 100,
    "background": {
      "type": "linear",
      "x1": 0,
      "y1": 0,
      "x2": 1,
      "y2": 1,
      "stops": [
        { "offset": 0, "color": "#0d1117" },
        { "offset": 1, "color": "#161b22ff" }
      ]
    }
  },
  "layers": [
    {
      "type": "rect",
      "width": 50,
      "height": 50,
      "fill": {
        "type": "radial",
        "cx": 0.5,
        "cy": 0.5,
        "r": 0.5,
        "stops": [
          { "offset": 0, "color": "#fff" },
          { "offset": 0.5, "color": "#ffff" },
          { "offset": 1, "color": "{{theme.accent}}" }
        ]
      },
      "stroke": {
        "type": "linear",
        "stops": [
          { "offset": 0, "color": "#000" },
          { "offset": 1, "color": "#fff" }
        ]
      }
    }
  ]
}
