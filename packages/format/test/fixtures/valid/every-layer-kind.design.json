{
  "version": 0,
  "title": "Every layer kind",
  "description": "One layer of each kind, with alternative text on the image.",
  "canvas": { "width": 400, "height": 200, "background": "#0d1117" },
  "styles": {
    "body": { "font": "inter", "fontSize": 14, "fill": "#e6edf3" }
  },
  "assets": {
    "fonts": {
      "inter": {
        "family": "Inter",
        "src": "fonts/Inter-Regular.woff2",
        "weight": 400,
        "style": "normal",
        "licence": { "embedding": "allowed", "name": "OFL-1.1" }
      }
    },
    "images": {
      "logo": { "src": "images/logo.png", "width": 32, "height": 32 }
    }
  },
  "components": {
    "badge": {
      "width": 80,
      "height": 20,
      "layers": [{ "type": "rect", "width": 80, "height": 20, "radius": 4, "fill": "#238636" }]
    }
  },
  "layers": [
    {
      "type": "group",
      "id": "root",
      "name": "Root",
      "x": 10,
      "y": 10,
      "children": [
        {
          "type": "rect",
          "id": "panel",
          "width": 380,
          "height": 180,
          "radius": 8,
          "fill": "#161b22",
          "stroke": "#30363d",
          "strokeWidth": 1
        },
        {
          "type": "ellipse",
          "id": "dot",
          "x": 20,
          "y": 20,
          "width": 10,
          "height": 10,
          "fill": "#3fb950"
        },
        {
          "type": "path",
          "id": "line",
          "d": "M0 0 L 100 0 Z",
          "stroke": "#8b949e",
          "strokeWidth": 2,
          "fill": "none"
        },
        {
          "type": "text",
          "id": "title",
          "x": 40,
          "y": 30,
          "content": "Hello, {{user.name}}",
          "style": "body",
          "align": "start"
        },
        {
          "type": "image",
          "id": "logo",
          "x": 340,
          "y": 10,
          "asset": "logo",
          "width": 32,
          "height": 32,
          "fit": "contain",
          "alt": "Readmint logo"
        },
        { "type": "component", "id": "status", "x": 300, "y": 150, "ref": "badge" }
      ]
    }
  ]
}
