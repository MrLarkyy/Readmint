{
  "name": "@readmint/cli",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "readmint": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@readmint/golden": "workspace:*"
  },
  "dependencies": {
    "@readmint/data": "workspace:*",
    "@readmint/data-feed": "workspace:*",
    "@readmint/data-github": "workspace:*",
    "@readmint/data-json": "workspace:*",
    "@readmint/expr": "workspace:*",
    "@readmint/format": "workspace:*",
    "@readmint/raster": "workspace:*",
    "@readmint/renderer": "workspace:*"
  }
}
