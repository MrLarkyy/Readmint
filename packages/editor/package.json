{
  "name": "@readmint/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "vite",
    "app": "vite build"
  },
  "dependencies": {
    "@readmint/data": "workspace:*",
    "@readmint/fonts": "workspace:*",
    "@readmint/format": "workspace:*",
    "@readmint/raster": "workspace:*",
    "@readmint/renderer": "workspace:*",
    "@resvg/resvg-wasm": "2.6.2",
    "wasm-webp": "0.1.0"
  },
  "devDependencies": {
    "@readmint/golden": "workspace:*",
    "vite": "8.3.4"
  }
}
